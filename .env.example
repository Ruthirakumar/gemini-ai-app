# Copy to .env.local and fill in. Never commit .env.local.

# --- Google Gemini (server only) -------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: a stronger vision model for reading worksheets (photo checker + library extraction).
# GEMINI_HOMEWORK_MODEL=

# --- Supabase (homework library, practice and results) ---------------------
# Project Settings -> API. The URL and anon/publishable key are designed to be
# public; data is protected by Row Level Security and column privileges.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used to read answer keys and save marks.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: separate secret for encrypting practice-question answers
# (defaults to a key derived from GEMINI_API_KEY).
# PRACTICE_TOKEN_SECRET=
